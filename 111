    <div class="container">
        <h1>Zero VPN</h1>
        <p>Ваша конфигурация успешно загружена.</p>
        <p>Скопируйте эту ссылку и вставьте её в приложение Happ для автоматического добавления всех серверов.</p>
        <p id="url-display" style="word-break: break-all; font-size: 12px; color: #aaa;"></p>
        <a href="#" class="btn" id="copy-btn" onclick="copyToClipboard()">Скопировать ссылку</a>
    </div>

    <script>
        function copyToClipboard() {
            const url = window.location.href;
            navigator.clipboard.writeText(url).then(() => {
                alert('Ссылка скопирована! Вставьте её в Happ.');
            });
        }
    </script>

